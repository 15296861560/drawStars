{
  "name": "drawstars",
  "version": "0.0.4",
  "scripts": {
    "dev": "vite --port 8081",
    "build": "vite build",
    "release": "set NODE_ENV=production && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "svgtofont": "node ./src/assets/js/svgtofont/svgtofont.js",
    "lint": "eslint src",
    "fix": "eslint src  --fix",
    "lint:fix": "eslint src --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "format": "eslint src --fix && prettier --write src package.json tsconfig.json tsconfig.config.json vite.config.ts tailwind.config.js .eslintrc.js env.d.ts .vscode",
    "update-css": "npx tailwindcss -i ./src/assets/styles/input.css -o ./src/assets/styles/output.css --watch",
    "prettier": "npx prettier . --write"
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@element-plus/icons-vue": "^2.3.2",
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@vueuse/core": "^11.3.0",
    "agora-rtc-sdk-ng": "latest",
    "agora-rtm-sdk": "latest",
    "axios": "^1.16.1",
    "baidu-map-vue3": "^0.4.9",
    "default-passive-events": "^2.0.0",
    "draw-stars-ui": "^1.0.3",
    "drawstarts-notify": "^0.0.7",
    "echarts": "^5.4.0",
    "element-plus": "^2.14.0",
    "leaflet": "^1.9.4",
    "leaflet.wmts": "^1.0.2",
    "less": "^4.6.4",
    "less-loader": "^11.1.0",
    "lint": "^1.2.2",
    "lodash": "^4.18.1",
    "mockjs": "^1.1.0",
    "nprogress": "^0.2.0",
    "particles.vue3": "^2.12.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "quill": "1.3.7",
    "sortablejs": "^1.15.7",
    "style-resources-loader": "^1.5.0",
    "tsparticles": "^2.6.0",
    "video.js": "^8.23.7",
    "vite-plugin-require-transform": "^1.0.21",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.2",
    "vue-jsonp": "^2.1.0",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^7.0.0",
    "@types/node": "^16.11.68",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^3.1.2",
    "@vitejs/plugin-vue-jsx": "^2.0.1",
    "autoprefixer": "^10.5.4",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.27.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier": "3.3.3",
    "svgtofont": "^3.25.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^3.1.8",
    "vite-plugin-require-transform": "^1.0.4",
    "vue-eslint-parser": "^9.3.2",
    "vue-tsc": "^1.8.27"
  },
  "parserOptions": {
    "requireConfigFile": false
  },
  "eslintConfig": {
    "parser": "babel-eslint"
  },
  "pnpm": {
    "overrides": {
      "@intlify/shared": "11.4.2",
      "@intlify/message-compiler": "11.4.2",
      "@intlify/vite-plugin-vue-i18n>@intlify/shared": "11.4.2",
      "@intlify/bundle-utils>@intlify/shared": "11.4.2",
      "@intlify/bundle-utils>@intlify/message-compiler": "11.4.2"
    }
  }
}
