NODE_ENV=development
# 为 true 时跳过登录与站内消息 WebSocket，无需后端即可浏览界面（仅用于本地/演示）
VITE_SKIP_LOGIN=false
# 为 false 时 AI 助手走真实 API
VITE_AI_ASSISTANT_MOCK=false
# 积分模块：false 走真实后端
VITE_POINTS_MOCK=false
# 任务模块：false 走真实后端（drawStars-serve-node）
VITE_TASK_MOCK=false
# 流程编排模块：false 走真实后端（drawStars-serve-node）
VITE_WORKFLOW_MOCK=false
# IM 模块：为 true 时走内存 Mock 网关（无后端联调 UI）；false 走真实后端 IM WS
VITE_IM_MOCK=false
# IM WebSocket 地址（留空则按当前站点协议/host 自动推导 ws(s)://<host>/im/ws）
VITE_IM_WS_URL=
